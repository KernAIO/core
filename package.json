{
  "name": "@kernhq/core",
  "version": "0.1.0",
  "private": true,
  "description": "Kern core service: identity/auth, workspaces, members, permissions, notifications, settings, files, search + module host",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/KernAIO/core"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.1",
    "@better-auth/passkey": "^1.7.1",
    "@better-auth/sso": "^1.7.1",
    "@kernhq/contracts": "^0.5.1",
    "@kernhq/kernel": "^0.7.0",
    "@kernhq/module-billing": "^0.3.1",
    "@kernhq/module-hr": "^0.9.1",
    "@kernhq/module-quire": "^0.7.1",
    "@kernhq/module-tracker": "^0.11.1",
    "@orpc/contract": "^1.15.0",
    "@orpc/openapi": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@orpc/zod": "^1.15.0",
    "better-auth": "^1.7.1",
    "dotenv": "^17.4.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.6.0",
    "jose": "^6.0.0",
    "nodemailer": "^9.0.0",
    "pg": "^8.16.0",
    "semver": "^7.7.0",
    "sharp": "^0.35.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@biomejs/biome": "^2.5.0",
    "@kernhq/testing": "^0.1.0",
    "@kernhq/tsconfig": "^0.1.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "@types/semver": "^7.7.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "overrides": {
      "@kernhq/kernel": "$@kernhq/kernel",
      "@kernhq/contracts": "$@kernhq/contracts"
    }
  }
}

# Core service. In development the umbrella repository's .env supplies the kernel-level variables
# (DATABASE_URL, NATS_URL, VALKEY_URL, KERN_SECRET, S3_*), so you only need this file when you run
# core on its own. Copy it to .env and fill in what you need.

# --- required -------------------------------------------------------------------------------
PORT=4000
DATABASE_URL=postgres://kern:kern@localhost:5432/kern
# 32 characters or more. Encrypts stored secrets; changing it makes existing ones unreadable.
KERN_SECRET=change-me-to-at-least-32-characters-long
# Signs sessions. Changing it signs everybody out.
BETTER_AUTH_SECRET=change-me-to-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:4000

# --- the first administrator ----------------------------------------------------------------
# Set these before the first start and core creates the instance administrator for you.
# Leave them empty and the first person to sign up becomes the administrator instead.
KERN_ADMIN_EMAIL=
KERN_ADMIN_PASSWORD=
KERN_ADMIN_NAME=

# --- optional -------------------------------------------------------------------------------
# Where account email goes before a workspace configures its own provider.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Kern <kern@localhost>

# Web push notifications. Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Sign in with an existing account. Each provider needs both values to be enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# The domain passkeys are bound to. Set it to the domain people visit.
PASSKEY_RP_ID=localhost

# Largest single upload, in bytes. Default is 100 MB.
UPLOAD_MAX_PUT_BYTES=104857600
